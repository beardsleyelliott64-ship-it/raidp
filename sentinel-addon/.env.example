# Required Discord credentials — set these in Railway Variables
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional for fast command registration in one test server; leave blank for global commands
DISCORD_GUILD_ID=

# Gemini AI — AI analysis gracefully disables if no key is provided
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Railway PostgreSQL: add a PostgreSQL service and reference its DATABASE_URL variable
# Example Railway variable reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# General bot settings
BOT_OWNER_IDS=
DEFAULT_LOG_CHANNEL_ID=
DEFAULT_APPLICATION_CHANNEL_ID=
DEFAULT_APPLICATION_REVIEW_CHANNEL_ID=
DEFAULT_MODERATOR_ROLE_ID=
DEFAULT_TRAINEE_ROLE_ID=

# Anti-raid defaults
RAID_JOIN_THRESHOLD=8
RAID_WINDOW_SECONDS=10
RAID_LOCKDOWN_MINUTES=5
ANTISPAM_MAX_MESSAGES=6
ANTISPAM_WINDOW_SECONDS=5
ANTISPAM_TIMEOUT_SECONDS=60

# Safety controls
# Set true only after testing the bot in a private server.
AUTO_LOCKDOWN=false
AI_MESSAGE_REVIEW=false
AI_INCIDENT_ANALYSIS=true

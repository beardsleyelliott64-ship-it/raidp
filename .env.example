# Copy this to .env for local testing — set these in Railway env vars for production

# Discord bot token (from discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Gemini API key (free at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Railway sets this automatically — only needed for local testing
# e.g. PUBLIC_URL=https://your-app.up.railway.app
PUBLIC_URL=https://your-app.up.railway.app

# Copy this to .env and fill in values
# On Render: set these in the Environment tab (not as a file)

BOT_TOKEN=your_discord_bot_token_here
GEMINI_KEY=your_google_gemini_api_key_here
GUILD_ID=your_server_id_here

PANEL_CHANNEL_ID=channel_id_for_learning_platform_panel
FREE_CHANNEL_ID=channel_id_for_free_bot_channel
LOG_CHANNEL_ID=channel_id_for_internal_logs
VERIFY_CHANNEL_ID=channel_id_for_premium_verification

# Optional: set to /data/senai.db on Render paid plan with disk mounted
# DB_PATH=senai.db

# .env.example — copy to .env and fill in values
# On Railway: set these in the Variables tab (not .env)

# Required
DISCORD_TOKEN=your_discord_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — set to your server's ID for instant slash command sync
# Leave blank for global sync (takes up to 1 hour)
GUILD_ID=your_guild_id_here

# Set automatically by Railway — do not override
# PORT=8080

DISCORD_TOKEN=put_bot_token_here
DISCORD_CLIENT_ID=put_application_client_id_here
# Public HTTPS address Render gives you, no trailing slash:
PUBLIC_URL=https://your-service-name.onrender.com
# Render assigns PORT automatically — leave blank locally or set 3000:
PORT=3000
# Optional: guild ID for fast command registration during testing:
GUILD_ID=

# REQUIRED
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# REQUIRED ONLY FOR DATABASE/ACCOUNT FEATURES
SUPABASEURL=
SUPABASEKEY=

# OPTIONAL WEBHOOKS
RESOURCE_WEBHOOK_URL=
ERROR_WEBHOOK_URL=
LOGS_WEBHOOK_URL=
STARTUP_WEBHOOK_URL=

# OPTIONAL CHANNEL/ROLE OVERRIDES (the bot can use config.json instead)
STATUS_CHANNEL_ID=
DOWN_CHANNEL_ID=
IMAGE_SOLVER_CHANNEL_ID=
BASE_ROLE_ID=

# Optional Discord permission/channel overrides
# ADMIN_ROLE_IDS=123456789012345678,987654321098765432
# SPARX_MATHS_CHANNEL_ID=123456789012345678
# SPARX_READER_CHANNEL_ID=123456789012345678
# SPARX_SCIENCE_CHANNEL_ID=123456789012345678
# SENECA_CHANNEL_ID=123456789012345678

GEMINI_API_KEY=
GEMINI_API_KEYS=

GEMINI_MODEL=gemini-3.5-flash-lite

# Reader tries these in order when Gemini is busy/unavailable
GEMINI_READER_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite-preview,gemini-3-flash-preview


# EAM public dashboard
PORT=3000
WEB_HOST=0.0.0.0
DISCORD_INVITE_URL=https://discord.com/
# Web dashboard Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-DOMAIN.example/auth/discord/callback
DISCORD_INVITE_URL=https://discord.gg/YOUR_INVITE
WEB_HOST=0.0.0.0
WEB_PORT=3000

# Request Jailbreak is available only to this Discord user ID.
JAILBREAK_OWNER_ID=1363240484818128926
# Optional Gemini Discord chatbot model
GEMINI_CHATBOT_MODEL=gemini-2.5-flash
